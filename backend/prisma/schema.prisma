datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DiscountType {
  FIXED
  PERCENT
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  UPI
  OTHER
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  role                Role                 @default(CUSTOMER)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  payments            Payment[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model Product {
  id                String             @id @default(cuid())
  name              String
  type              String
  salesPrice        Decimal            @db.Decimal(12, 2)
  costPrice         Decimal            @db.Decimal(12, 2)
  notes             String?
  variants          ProductVariant[]
  discounts         Discount[]
  templateLines     TemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
}

model ProductVariant {
  id                String             @id @default(cuid())
  productId         String
  attribute         String
  value             String
  extraPrice        Decimal            @default(0) @db.Decimal(12, 2)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  templateLines     TemplateLine[]
  subscriptionLines SubscriptionLine[]

  @@unique([productId, attribute, value])
}

model Plan {
  id                 String              @id @default(cuid())
  name               String
  price              Decimal             @db.Decimal(12, 2)
  billingPeriod      BillingPeriod
  minQuantity        Int                 @default(1)
  startDate          DateTime
  endDate            DateTime?
  autoClose          Boolean             @default(false)
  allowEarlyClose    Boolean             @default(false)
  allowPause         Boolean             @default(false)
  allowRenew         Boolean             @default(false)
  quotationTemplates QuotationTemplate[]
  subscriptions      Subscription[]
}

model Tax {
  id                String             @id @default(cuid())
  name              String
  ratePercent       Decimal            @db.Decimal(5, 2)
  productType       String?
  subscriptionLines SubscriptionLine[]
}

model Discount {
  id          String        @id @default(cuid())
  name        String
  type        DiscountType
  value       Decimal       @db.Decimal(12, 2)
  minPurchase Decimal?      @db.Decimal(12, 2)
  minQuantity Int?
  startDate   DateTime
  endDate     DateTime
  usageLimit  Int?
  usedCount   Int           @default(0)
  appliesTo   DiscountScope
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  invoices    Invoice[]

  @@index([startDate, endDate])
}

model QuotationTemplate {
  id           String         @id @default(cuid())
  name         String
  validityDays Int
  planId       String
  plan         Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines        TemplateLine[]
}

model TemplateLine {
  id         String            @id @default(cuid())
  templateId String
  productId  String
  variantId  String?
  quantity   Int
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
}

model Subscription {
  id              String             @id @default(cuid())
  number          String             @unique
  customerId      String
  planId          String
  startDate       DateTime
  expiryDate      DateTime?
  paymentTerms    String
  status          SubscriptionStatus @default(DRAFT)
  nextBillingDate DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  customer        User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan            Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines           SubscriptionLine[]
  invoices        Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxId          String?
  amount         Decimal         @db.Decimal(12, 2)
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  tax            Tax?            @relation(fields: [taxId], references: [id], onDelete: Restrict)
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  subscriptionId String
  customerId     String
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  discountId     String?
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime
  createdAt      DateTime      @default(now())
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customer       User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  discount       Discount?     @relation(fields: [discountId], references: [id], onDelete: Restrict)
  lines          InvoiceLine[]
  payments       Payment[]

  @@unique([subscriptionId, periodStart])
  @@index([customerId])
  @@index([status, dueDate])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxAmount   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paidOn       DateTime
  note         String?
  recordedById String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy   User          @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}
